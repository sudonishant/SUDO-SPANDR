{
  "name": "sudo-spandr-web-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "allowScripts": {
    "esbuild": true
  },
  "scripts": {
    "dev": "vite --config vite.config.mjs",
    "build": "vite build",
    "lint": "node scripts/check-forensic-claims.mjs",
    "test": "node scripts/test-email-forensics.mjs",
    "preview": "vite preview --config vite.config.mjs",
    "rea:service": "node scripts/rea-analysis-server.mjs",
    "deploy": "npx wrangler pages deploy dist",
